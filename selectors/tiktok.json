{
  "platform": "tiktok",
  "version": 1,
  "saved": {
    "itemSelectors": "a[href*=\"/video/\"], a[href*=\"/photo/\"]",
    "contentPathPattern": "^\\/@[^/]+\\/(video|photo)\\/\\d+\\/?$",
    "thumbnailSelector": "img",
    "scroll": {
      "waitMs": 1200,
      "maxIterations": 120,
      "maxStableRounds": 10,
      "maxRuntimeMs": 120000
    }
  },
  "collections": {
    "containerSelector": "[data-e2e=\"collection-list-item\"]",
    "linkSelector": "a[href*=\"/collection/\"]",
    "slugPattern": "\\/@[^/]+\\/collection\\/([^/?]+)",
    "footerSelector": "[data-e2e=\"collection-card-footer\"]",
    "infoContainerSelector": "[data-e2e=\"collection-card-footer\"] [class*=\"CollectionInfoContainer\"], [data-e2e=\"collection-card-footer\"] span",
    "itemCountPattern": "(\\d+)\\s*(videos?|items?|개|件)",
    "itemCountSkipPattern": "^\\d+\\s*(videos?|items?|개|件)",
    "slugCleanupPattern": "-\\d{10,}$",
    "thumbnailSelector": "img",
    "cardWaitSelector": "[data-e2e=\"collection-list-item\"], a[href*=\"/collection/\"]",
    "scroll": { "waitMs": 1000, "maxIterations": 30, "maxStableRounds": 6 }
  },
  "tabs": {
    "favoritesTab": {
      "strategies": [
        { "selector": "p[class*=\"PFavorite\"], [class*=\"PFavorite\"]" },
        { "selector": "[data-e2e=\"favorites-tab\"], [data-e2e=\"favourites-tab\"]" },
        { "selector": "[role=\"tab\"]", "matchLabels": true },
        { "selector": "[data-e2e*=\"tab\"], [class*=\"TabItem\"], [class*=\"tab-item\"]", "matchLabels": true }
      ],
      "labels": ["favorites", "favourite", "favoris", "즐겨찾기", "お気に入り", "收藏", "收藏夾"]
    },
    "postsSubTab": {
      "primarySelector": "button#posts",
      "fallbackSelector": "[class*=\"ButtonSubTab\"], [class*=\"TUXButton\"], [role=\"tab\"]",
      "labels": ["posts", "post", "게시물", "投稿", "帖子", "貼文"]
    },
    "collectionsSubTab": {
      "primarySelector": "button#collections",
      "fallbackSelectors": [
        "[data-e2e=\"collections-tab\"], [data-e2e=\"collection-tab\"]",
        "[class*=\"ButtonSubTab\"], [class*=\"TUXButton\"], [role=\"tab\"]"
      ],
      "labels": ["collections", "collection", "컬렉션", "コレクション", "合集", "合輯"]
    }
  },
  "login": {
    "selectors": [
      "[data-e2e=\"nav-login-button\"]",
      "[class*=\"LoginButton\"]",
      "button[id*=\"header-login\"]",
      "[data-e2e=\"tiktok-login-button\"]"
    ],
    "modalSelectors": [
      "[class*=\"LoginModal\"]",
      "[class*=\"login-modal\"]",
      "[data-e2e=\"login-modal\"]",
      "div[class*=\"DivLoginContainer\"]"
    ],
    "loginPagePath": "/login",
    "contentPresenceSelector": "a[href*=\"/video/\"], a[href*=\"/photo/\"]"
  }
}
